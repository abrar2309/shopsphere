flowchart TB
  subgraph Browser["Browser"]
    UI["React + Vite UI"]
    CLIENT["Frontend API modules / HTTP client"]
    UI --> CLIENT
  end
  subgraph Backend["Spring Boot modular monolith"]
    SEC["SecurityFilterChain + JWT"]
    CTRL["REST controllers"]
    SERVICE["Application services"]
    DATA["JPA repositories / JdbcTemplate"]
    OUTBOX["Outbox services + scheduled publisher"]
    LISTENERS["Kafka consumers"]
    SEC --> CTRL --> SERVICE --> DATA
    SERVICE --> OUTBOX
    LISTENERS --> SERVICE
  end
  subgraph Infra["Dependencies"]
    PG[("PostgreSQL")]
    REDIS[("Redis")]
    KAFKA[("Kafka: order-created")]
  end
  subgraph Embedding["Separate BGE service"]
    FASTAPI["FastAPI"]
    MODEL["BAAI/bge-small-en-v1.5"]
    FASTAPI --> MODEL
  end
  CLIENT --> SEC
  DATA <--> PG
  OUTBOX --> PG
  OUTBOX --> KAFKA
  KAFKA --> LISTENERS
  SERVICE <--> REDIS
  SERVICE <--> FASTAPI
